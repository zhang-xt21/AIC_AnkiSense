# demo = explicit fixture demonstration; cloud = real model API
AI_MODE=demo
# Set all three values before enabling cloud mode. Never commit the API key.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45
# Optional: override storage; relative paths always start at the project root.
# Absolute paths are also supported for storage outside the project.
# ANKISENSE_DATA_DIR=./data
