{
  "name": "ankisense",
  "version": "0.1.0",
  "private": true,
  "description": "Offline UI verification tools for AnkiSense",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/test_node.cjs",
    "test:browser": "npm run test:browser:feedback && npm run test:browser:workbench && npm run test:browser:settings && npm run test:browser:automatic-import && npm run test:browser:integrated",
    "test:browser:feedback": "node tools/feedback_check.cjs",
    "test:browser:studio": "node tools/studio_check.cjs",
    "test:browser:workbench": "node tools/workbench_check.cjs",
    "test:browser:settings": "node tools/model_settings_check.cjs",
    "test:browser:source-ai": "node tools/source_ai_proofread_check.cjs",
    "test:browser:auto-learning": "node tools/auto_learning_check.cjs",
    "test:browser:generation": "node tools/generation_check.cjs",
    "test:browser:auto-illustration": "node tools/auto_illustration_check.cjs",
    "test:browser:automatic-import": "node tools/automatic_import_check.cjs",
    "test:browser:auto-cards": "node tools/auto_cards_check.cjs",
    "test:browser:integrated": "node tools/integrated_desktop_check.cjs",
    "test:desktop": "node --test desktop/health.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
